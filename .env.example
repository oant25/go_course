HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

DATABASE_URL=postgres://tripgo:tripgo@localhost:5432/tripgo?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s

HTTP_READ_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=2s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

IDEMPOTENCY_TTL=24h
IDEMPOTENCY_CLEANUP_INTERVAL=1h
OTEL_SERVICE_NAME=trip-service
HTTP_RESPONSE_BUFFER_BYTES=1048576

OTEL_RESOURCE_ATTRIBUTES=service.namespace=tripgo,deployment.environment=local,service.version=dev
# Значения в .env заполняет tripgoctl connect.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=
OTEL_EXPORTER_OTLP_TIMEOUT=5000
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_METRIC_EXPORT_TIMEOUT=5000
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
TELEMETRY_ERROR_LOG_INTERVAL=30s
